#!/usr/bin/make -f

# See debhelper(7) (uncomment to enable).
# Output every command that modifies files on the build system.
#export DH_VERBOSE = 1


# See FEATURE AREAS in dpkg-buildflags(1).
#export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# See ENVIRONMENT in dpkg-buildflags(1).
# Package maintainers to append CFLAGS.
#export DEB_CFLAGS_MAINT_APPEND  = -Wall -pedantic
# Package maintainers to append LDFLAGS.
#export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed
# Read architecture variables from the build system environment
DEB_HOST_ARCH         ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
DEB_HOST_GNU_TYPE     ?= $(shell dpkg-architecture -qDEB_HOST_GNU_TYPE)
DEB_HOST_MULTIARCH    ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)
# Configure version mapping tags
#GCC_VERSION = -14
GCC_VERSION = -14

# Dynamically set the qmake command name and configuration profile
ifeq ($(DEB_HOST_ARCH),arm64)
    QMAKE_CMD  = aarch64-linux-gnu-qmake6
    QMAKE_SPEC = linux-aarch64-gnu-g++
    # Resolves to aarch64-linux-gnu-gcc-14
    CC_EXEC    = /usr/local/gcc-16.2.0-arm64/bin/aarch64-linux-gnu-gcc-16.2
    CXX_EXEC   = /usr/local/gcc-16.2.0-arm64/bin/aarch64-linux-gnu-g++-16.2
    # Force the use of the system cross-assembler to fix the '-EL' error
    AS_EXEC    = /usr/aarch64-linux-gnu/bin/as
    AS_EXEC  := /usr/local/gcc-16.2.0-arm64/bin/as
#    CC_EXEC    = $(DEB_HOST_GNU_TYPE)-gcc$(GCC_VERSION)
#    CXX_EXEC   = $(DEB_HOST_GNU_TYPE)-g++$(GCC_VERSION)
    export C_INCLUDE_PATH=/usr/include/$(DEB_HOST_MULTIARCH):/usr/include
    export CPLUS_INCLUDE_PATH=/usr/include/$(DEB_HOST_MULTIARCH):/usr/include
    export DEB_CXXFLAGS_MAINT_APPEND = -B/usr/local/gcc-16.2.0-arm64/bin/
    export DEB_CFLAGS_MAINT_APPEND = -B/usr/local/gcc-16.2.0-arm64/bin/
else
    QMAKE_CMD  = qmake6
    QMAKE_SPEC = linux-g++
    AS_EXEC    = as
    CC_EXEC    = gcc
    CXX_EXEC   = g++
    unexport C_INCLUDE_PATH
    unexport CPLUS_INCLUDE_PATH
endif

%:
	dh $@
# --buildsystem qmake

# Create binary tarball for RPM build

DEB_SOURCE := $(shell dpkg-parsechangelog --show-field Source)
DEB_VERSION := $(shell dpkg-parsechangelog --show-field Version)
DEB_BUILD_ARCH := $(shell dpkg-architecture -qDEB_HOST_GNU_CPU)

override_dh_auto_configure:
	@echo ======================================================= override_dh_auto_configure
	# 1. Dynamically generate the localized .desktop entries into the project root
	mkdir -p build
	# Extracts package name natively via debian/control tracking if DEB_SOURCE is unset
	$(eval PKG_NAME := $(shell dh_listpackages | head -n1))
	cp debian/$(PKG_NAME).desktop.in build/$(PKG_NAME).desktop
	cd build && \
	QMAKE_MOC=/usr/lib/qt6/libexec/moc \
	QMAKE_UIC=/usr/lib/qt6/libexec/uic \
	QMAKE_RCC=/usr/lib/qt6/libexec/rcc \
	$(QMAKE_CMD) -spec $(QMAKE_SPEC) \
		QMAKE_CC=$(CC_EXEC) \
		QMAKE_CXX=$(CXX_EXEC) \
		QMAKE_LINK=$(CXX_EXEC) \
		QMAKE_AS=$(AS_EXEC) \
		QMAKE_SET_BUILD_FLAGS=no \
		PKG_CONFIG="pkg-config" \
		PKG_CONFIG_LIBDIR="/usr/lib/$(DEB_HOST_MULTIARCH)/pkgconfig:/usr/share/pkgconfig" \
		QT_VERSION_MAJOR=6 \
		../../*.pro

override_dh_auto_build:
	@echo ======================================================= override_dh_auto_build
	# Compile using make inside the custom build directory
	$(MAKE) -C build

override_dh_auto_install:
	@echo ======================================================= override_dh_auto_install
	$(MAKE) -C build install INSTALL_ROOT=$(CURDIR)/debian/${DEB_SOURCE}


override_dh_install:
	@echo ======================================================= override_dh_auto_install
	dh_install
	dh_strip
	tar --numeric-owner --owner=0 --group=0  \
	 -cJf ../../$(DEB_SOURCE)_$(DEB_VERSION)_$(DEB_HOST_ARCH).txz \
	 -C $(CURDIR)/debian/${DEB_SOURCE} .

override_dh_builddeb:
	@echo ======================================================= override_dh_builddeb
	dh_builddeb

override_dh_auto_clean:
	@echo ======================================================= override_dh_auto_clean
	rm -rf build
	rm -rf ../../$(DEB_SOURCE)*$(DEB_VERSION)_$(DEB_HOST_ARCH)*
	-dh_auto_clean

override_dh_gencontrol:
	@echo ======================================================= override_dh_gencontrol
	dh_gencontrol
	find debian/ -type f -name "control" -exec sed -i 's/\(lib[a-zA-Z0-9+-]*\)t64/\0 | \1/g' {} +